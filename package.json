{
  "name": "prontuario-aprimorado",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "node --test --experimental-strip-types tests/golden-master/*.test.ts",
    "test:golden": "node --test --experimental-strip-types tests/golden-master/*.test.ts",
    "test:clinical": "node --experimental-strip-types --test tests/golden-master/*.test.ts",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "validate:domain": "node --experimental-strip-types --test tests/golden-master/*.test.ts && tsc -p tsconfig.domain.json",
    "validate:security": "node --experimental-strip-types --test tests/golden-master/security-*.test.ts tests/golden-master/html-safety.test.ts tests/golden-master/consultation-workflow.test.ts",
    "backup:check": "bash scripts/check-backup-tools.sh",
    "validate:repo": "node scripts/validate-repo.mjs",
    "test:backup": "bash scripts/test-backup-roundtrip.sh"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@prisma/client": "^7.7.0",
    "@prisma/adapter-mariadb": "^7.7.0",
    "dotenv": "^17.0.0",
    "better-auth": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.6.0"
  },
  "devDependencies": {
    "prisma": "^7.7.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true
  }
}
